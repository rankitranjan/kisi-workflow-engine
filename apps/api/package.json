{
  "name": "@kisi-workflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "DATABASE_URL=${DATABASE_URL:-postgresql://kisi:kisi@localhost:5432/workflow_engine} prisma generate && tsc --noEmit",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://kisi:kisi@localhost:5432/workflow_engine} prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@kisi-workflow/shared": "*",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "vitest": "^5.0.1"
  }
}
