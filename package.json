{
  "name": "kisi-workflow-engine",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @kisi-workflow/e2e",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @kisi-workflow/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
